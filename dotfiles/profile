#!/bin/bash

# Bash History
HISTCONTROL="ignoreboth:erasedups"
HISTFILE="$HOME/.bash_history"
HISTFILESIZE=100000 # Maximum number of lines in history file on disk
HISTSIZE=50000 # Number of lines kept in session history
# Use standard ISO 8601 timestamp.
# %F equivalent to %Y-%m-%d
# %T equivalent to %H:%M:%S (24-hours format)
HISTTIMEFORMAT='%F %T '

alias h='history'
alias hs="history | sed 's/^[ ]*[0-9]*[ ]*//' | sort | uniq -c | sort -n"

# Bash Prompt
# folder_name: (git_branch_name)
PS1="\[\e[0;36m\]\W:\[\e[0;33m\]\$(__git_ps1)\[\e[0m\] "

# Append to history file rather than overwriting it
shopt -s histappend

# Save multi-line commands as a single history entry (keeps stats clean)
shopt -s cmdhist

# Case-insensitive globbing (used in pathname expansion)
shopt -s nocaseglob

# Set PATH, MANPATH, etc., for Homebrew.
if [ -f "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Load bash completion
if [ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]; then
  # shellcheck disable=SC1091
  source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"

  # Set autocomplete for "g" git alias
  __git_complete g __git_main
fi

for profile_config in "$HOME"/.profile.d/*.sh; do
  # shellcheck disable=SC1090
  source "$profile_config"
done

unset profile_config

if [ ! -f "$HOME/.bash_local" ]; then
  touch "$HOME/.bash_local"
fi
# shellcheck disable=SC1091
source "$HOME/.bash_local"
