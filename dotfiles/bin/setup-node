#!/bin/zsh
#
# Summary: Install a Node version using nodenv and node-build
#
# Usage: setup-node <version>

set -e

if [ "$#" -eq 0 ]; then
  echo "Error: Missing or invalid version."
  echo "Usage: setup-node <version>"
  exit 1
fi

# shellcheck disable=SC1090
source "$HOME/.zshrc" # needed for `nodenv shell` usage

log_info() {
  echo "$(date +%H:%M:%S) - $1"
}

install_node() {
  local node_version="$1"
  if nodenv versions --bare | grep -Fxq -- "$node_version"; then
    log_info "Node ${node_version} already installed."
    return
  fi

  log_info "Installing Node ${node_version}."
  nodenv install "$node_version"
  nodenv shell "$node_version"
  log_info "Node ${node_version} installed."
  npm install -g npm corepack @openai/codex
}

if [ "$#" -eq 1 ]; then
  install_node "$1"
fi
