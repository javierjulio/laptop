#!/bin/zsh

PROJECTS_PREFIX="$HOME/Projects"
TERMINAL_PROFILE="Nord"

log_info() {
  echo "$(date +%H:%M:%S) - $1"
}

reload_profile() {
  # shellcheck disable=SC1090
  source "$HOME/.zshrc"
}

clone_project() {
  local dir
  dir=$(basename "${2:-$1}")
  if [ ! -d "$PROJECTS_PREFIX/$dir" ]; then
    git clone "https://github.com/$1.git" "$PROJECTS_PREFIX/${dir}"
    echo "Cloned $1 successfully."
  fi
}

log_info "Running laptop script."

setup/dotfiles.sh
setup/homebrew.sh

reload_profile

log_info "Running Brew bundler..."
brew bundle --no-upgrade
brew bundle --file=Caskfile

reload_profile

log_info "Setting macOS defaults."
setup/macos.sh

log_info "Cloning GitHub projects."
clone_project "javierjulio/javierjulio.github.io" "javierjulio"
clone_project "javierjulio/cheats"
clone_project "javierjulio/chris-courses"
clone_project "javierjulio/envied"
clone_project "javierjulio/game-dev"
clone_project "javierjulio/gdevelop-examples"
clone_project "javierjulio/how-to-program-games"
clone_project "javierjulio/humble-bundle-key-exporter"
clone_project "javierjulio/manager-game-sources"
clone_project "javierjulio/memory-game"
clone_project "javierjulio/new-star-manager-data"
clone_project "javierjulio/nonograms-game"
clone_project "javierjulio/real-world-code"
clone_project "javierjulio/soccer-manager-game"
clone_project "javierjulio/tailwind-all-access"
clone_project "javierjulio/wq"
clone_project "activeadmin/activeadmin"
clone_project "activeadmin/arbre"
clone_project "activeadmin/demo.activeadmin.info" "activeadmin-demo"
clone_project "activeadmin/inherited_resources"

reload_profile

setup/ruby.sh 4.0.7
rbenv global 4.0.7

reload_profile

setup/node.sh 24.20.0
nodenv global 24.20.0

terminal_theme=$(defaults read ~/Library/Preferences/com.apple.Terminal.plist "Default Window Settings")
if [ "$terminal_theme" != "$TERMINAL_PROFILE" ]; then
  log_info "Installing $TERMINAL_PROFILE Terminal theme..."
  open "$(pwd)/themes/$TERMINAL_PROFILE.terminal"
  sleep 1
  osascript -e 'tell application "Terminal" to set default settings to settings set "'"$TERMINAL_PROFILE"'"'
  osascript -e 'tell application "Terminal" to set startup settings to settings set "'"$TERMINAL_PROFILE"'"'
fi

log_info "Done"
