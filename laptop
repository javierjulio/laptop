#!/bin/zsh

PROJECTS_PREFIX="$HOME/Projects"
TERMINAL_PROFILE="Nord"

log_info() {
  echo "$(date +%H:%M:%S) - $1"
}

reload_profile() {
  # shellcheck disable=SC1090
  source "$HOME/.zshrc"
}

clone_project() {
  local dir
  dir=$(basename "${2:-$1}")
  if [ ! -d "$PROJECTS_PREFIX/$dir" ]; then
    git clone "https://github.com/$1.git" "$PROJECTS_PREFIX/${dir}"
    echo "Cloned $1 successfully."
  fi
}

log_info "Running laptop script."

setup/dotfiles.sh

if command -v brew >/dev/null 2>&1; then
  log_info "Updating Homebrew..."
  brew update
else
  log_info "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
fi

reload_profile

log_info "Running Brew bundler..."
brew bundle --no-upgrade
brew bundle --file=Caskfile

reload_profile

log_info "Setting macOS defaults."

# Close any open System Preferences panes, to prevent them from
# overriding settings we're about to change.
osascript -e 'tell application "System Preferences" to quit'

# Finder: Show the ~/Library folder.
chflags nohidden ~/Library

# Dock: Automatically hide and show Dock
defaults write com.apple.dock autohide -bool true
# Dock: Don’t show recent applications in Dock
defaults write com.apple.dock show-recents -bool false

# Safari: Hide Favorites bar by default
defaults write com.apple.Safari ShowFavoritesBar-v2 -bool false
# Safari: Opens with all windows from last session
defaults write com.apple.Safari AlwaysRestoreSessionAtLaunch -bool true
# Safari: New windows and tabs open with empty page
defaults write com.apple.Safari NewWindowBehavior -int 1
defaults write com.apple.Safari NewTabBehavior -int 1
# Safari: Remove history items after one month
defaults write com.apple.Safari HistoryAgeInDaysLimit -int 31
# Safari: Disable AutoFill
defaults write com.apple.Safari AutoFillPasswords -bool false
# Safari: Smart Search Field
defaults write com.apple.Safari PreloadTopHit -bool false
defaults write com.apple.Safari ShowFavoritesUnderSmartSearchField -bool false
# Safari: Enable the Develop menu and the Web Inspector in Safari
defaults write com.apple.Safari IncludeDevelopMenu -bool true
defaults write com.apple.Safari WebKitDeveloperExtrasEnabledPreferenceKey -bool true
defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true

# TextEdit: Start with plain text
defaults write com.apple.TextEdit RichText -int 0
# TextEdit: Do not show ruler on start
defaults write com.apple.TextEdit ShowRuler -int 0
# TextEdit: Set font
defaults write com.apple.TextEdit NSFixedPitchFont -string "Menlo-Regular"
# TextEdit: Set larger font size
defaults write com.apple.TextEdit NSFixedPitchFontSize -int 13

add_login_window_text() {
  local name phone email
  echo "macOS: Answer prompts for Lock Screen message (requires password)"
  printf 'Enter phone: ' && read phone
  printf 'Enter email: ' && read email
  sudo defaults write /Library/Preferences/com.apple.loginwindow LoginwindowText \
    "$(printf "Found this computer?\nPhone: $phone\nEmail: $email")"
}

defaults read /Library/Preferences/com.apple.loginwindow LoginwindowText &>/dev/null || add_login_window_text

log_info "Cloning GitHub projects."
clone_project "javierjulio/javierjulio.github.io" "javierjulio"
clone_project "javierjulio/cheats"
clone_project "javierjulio/chris-courses"
clone_project "javierjulio/envied"
clone_project "javierjulio/game-dev"
clone_project "javierjulio/gdevelop-examples"
clone_project "javierjulio/how-to-program-games"
clone_project "javierjulio/humble-bundle-key-exporter"
clone_project "javierjulio/manager-game-sources"
clone_project "javierjulio/memory-game"
clone_project "javierjulio/new-star-manager-data"
clone_project "javierjulio/nonograms-game"
clone_project "javierjulio/real-world-code"
clone_project "javierjulio/soccer-manager-game"
clone_project "javierjulio/tailwind-all-access"
clone_project "javierjulio/wq"
clone_project "activeadmin/activeadmin"
clone_project "activeadmin/arbre"
clone_project "activeadmin/demo.activeadmin.info" "activeadmin-demo"
clone_project "activeadmin/inherited_resources"

reload_profile

setup-ruby 4.0.7
rbenv global 4.0.7

reload_profile

setup-node 24.20.0
nodenv global 24.20.0

terminal_theme=$(defaults read ~/Library/Preferences/com.apple.Terminal.plist "Default Window Settings")
if [ "$terminal_theme" != "$TERMINAL_PROFILE" ]; then
  log_info "Installing $TERMINAL_PROFILE Terminal theme..."
  open "$(pwd)/themes/$TERMINAL_PROFILE.terminal"
  sleep 1
  osascript -e 'tell application "Terminal" to set default settings to settings set "'"$TERMINAL_PROFILE"'"'
  osascript -e 'tell application "Terminal" to set startup settings to settings set "'"$TERMINAL_PROFILE"'"'
fi

log_info "Done"
